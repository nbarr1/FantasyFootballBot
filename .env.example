# Copy to .env (or export these directly) and fill in.
# NOTHING in this file should ever be committed.
#
# The bot reads secrets from the environment only. It never stores them in the
# database, never writes them to a log, and never shows them in the approval
# interface.

# --- MFL authentication (required before anything can run) -------------------
# Two mechanisms; the client selects by which variables are present.
#
# 1. Username/password. Exchanged once for a session cookie. REQUIRED for any
#    write (lineup, add/drop, trade) -- an API key alone cannot act on your
#    franchise's behalf.
MFLBOT_MFL_USERNAME=
MFLBOT_MFL_PASSWORD=

# 2. Per-league API key, generated on MFL's Developer API page. Unlocks
#    private-league reads. Optional if you set username/password.
MFLBOT_MFL_API_KEY=

# Alternative to putting secrets in the environment: point at a file containing
# KEY=value lines. It must be mode 0600 or the bot refuses to read it.
# MFLBOT_SECRETS_FILE=/etc/mflbot/secrets.env

# --- Approval token signing key ----------------------------------------------
# Signs approval tokens. If unset, a random key is generated on first use and
# written to .approval_secret (mode 0600). Set it explicitly in a container,
# where the filesystem does not persist.
# MFLBOT_APPROVAL_SECRET=

# --- Notifications (optional) -------------------------------------------------
# Generic webhook. A Discord channel webhook URL works as-is.
MFLBOT_WEBHOOK_URL=

# Stubs -- these transports are not implemented; the variables are listed so the
# interface points are visible.
# MFLBOT_SMTP_HOST=
# MFLBOT_EMAIL_TO=
# MFLBOT_TELEGRAM_TOKEN=
# MFLBOT_TELEGRAM_CHAT_ID=

# --- Paid news providers (stubs, not implemented) -----------------------------
# MFLBOT_SPORTSDATAIO_KEY=
# MFLBOT_FANTASYNERDS_KEY=
# MFLBOT_ROTOWIRE_KEY=
