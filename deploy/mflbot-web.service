# systemd unit for the mflbot dashboard, with the scheduler in the same process.
#
# Run THIS or mflbot.service, not both: they would be two processes writing to
# one SQLite database.
#
# Install:
#   sudo cp deploy/mflbot-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mflbot-web
#
# Then open http://127.0.0.1:8765. Set MFLBOT_WEB_PASSWORD in the secrets file
# below; without it the server prints a login link to the journal instead
# (journalctl -u mflbot-web) which is valid only until the service restarts,
# and it refuses to bind anything but loopback.
#
# It is plain HTTP by design: reach it over an SSH tunnel
#   ssh -N -L 8765:127.0.0.1:8765 you@host
# or put a TLS-terminating reverse proxy in front of it. Approving still
# produces one token per action, exactly as it does from the CLI.

[Unit]
Description=mflbot dashboard -- approvals, ingestion and analysis over HTTP
Documentation=https://github.com/nbarr1/FantasyFootballBot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mflbot
Group=mflbot
WorkingDirectory=/opt/mflbot

# Credentials. The file must be mode 0600 and owned by the service user;
# systemd reads it as root before dropping privileges.
EnvironmentFile=/etc/mflbot/secrets.env

ExecStart=/opt/mflbot/.venv/bin/bot --config /opt/mflbot/config.toml serve \
    --host 127.0.0.1 --port 8765 --with-scheduler

Restart=on-failure
RestartSec=30s

# Hardening. The bot needs outbound HTTPS and its own state directory; nothing
# else. Credentials in the environment are not readable by other users.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/opt/mflbot
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mflbot-web

[Install]
WantedBy=multi-user.target
